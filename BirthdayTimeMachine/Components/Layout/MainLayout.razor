@inherits LayoutComponentBase

<div class="app-shell">
  <header class="site-nav">
        <div class="container-xl page-width d-flex flex-wrap align-items-start justify-content-between gap-3">
            <a class="logo-badge" href="" aria-label="Birthday Time Machine home">
                <span class="logo-script">Birthday</span>
                <span class="logo-small">TIME MACHINE</span>
            </a>
            <nav class="site-links d-flex flex-wrap gap-4">
                <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="nav-item-link" href="birthday">My birthday page</NavLink>
                <NavLink class="nav-item-link" href="saved">Saved pages</NavLink>
            </nav>
        </div>
    </header>

    <main class="site-main">
        <div class="container-xl page-width py-4 py-md-5">
            @Body
        </div>
    </main>

        <footer class="site-footer">
        <div class="container-xl page-width py-2 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <a class="brand" href="">Birthday Time Machine</a>
            </div>

            <div>
                <p class="small footer-muted mb-2">Made with data from</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="source-tag " href="https://open-meteo.com/" target="_blank">Open-Meteo</a>
                    <a class="source-tag " href="https://apod.nasa.gov/" target="_blank">NASA APOD</a>
                    <a class="source-tag " href="https://www.themoviedb.org/" target="_blank">TMDB</a>
                    <a class="source-tag " href="https://date.nager.at/" target="_blank">Nager.Date</a>
                    <a class="source-tag " href="https://www.wikipedia.org/" target="_blank">Wikipedia</a>
                </div>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>