@page "/saved"
@using BirthdayTimeMachine.Models
@using BirthdayTimeMachine.Helpers
@using BirthdayTimeMachine.Services.Interfaces
@inject IReportStorageService ReportStorage
@inject ILogger<SavedReports> Logger

<PageTitle>Saved pages</PageTitle>

<h1 class="mb-1">Saved pages</h1>
<p class="lead text-muted-sb mb-4">Every birthday you've saved, pinned in one place.</p>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-3">
        <div class="spinner-border" style="color: var(--sb-accent);" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="hand">Opening the scrapbook...</span>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="paper note"><i class="bi bi-exclamation-circle me-1"></i> @errorMessage</div>
}
else if (allReports.Count == 0)
{
    <div class="paper note tape tilt-l" style="max-width: 520px;">
        <h3 class="mb-2">Nothing pinned yet</h3>
        <p class="mb-3">Make your first birthday page and save it to see it here.</p>
        <a class="btn btn-primary" href="birthday"><i class="bi bi-clock-history"></i> Make my page</a>
    </div>
}
else
{
    <div class="row g-4 mb-5">
        @* summary worked out with LINQ *@
        <div class="col-lg-5">
            <div class="paper note tape tilt-l h-100">
                <h3 class="mb-2">In my scrapbook</h3>
                <p class="mb-1"><strong>@allReports.Count</strong> saved page(s)</p>
                @if (warmest != null)
                {
                    <p class="mb-1">
                        <i class="bi bi-thermometer-sun"></i> Warmest:
                        <strong>@warmest.Name</strong> (@(warmest.MaxTemperature)°C)
                    </p>
                }
                @if (coldest != null)
                {
                    <p class="mb-1">
                        <i class="bi bi-thermometer-snow"></i> Coldest:
                        <strong>@coldest.Name</strong> (@(coldest.MaxTemperature)°C)
                    </p>
                }
                <p class="mb-0">
                    <i class="bi bi-cloud-rain"></i> Rainy birthdays: <strong>@allReports.Count(r => r.WasRainy)</strong>
                </p>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="paper tilt-r h-100">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="search">Search by name or city</label>
                        <input id="search" class="form-control" @bind="searchText" @bind:event="oninput" placeholder="e.g. Dublin" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="sort">Sort by</label>
                        <select id="sort" class="form-select" @bind="sortOption">
                            <option value="@ReportSortOption.RecentlySaved">Recently saved</option>
                            <option value="@ReportSortOption.OldestBirthday">Oldest birthday first</option>
                            <option value="@ReportSortOption.NewestBirthday">Newest birthday first</option>
                            <option value="@ReportSortOption.Warmest">Warmest birthday</option>
                            <option value="@ReportSortOption.Coldest">Coldest birthday</option>
                            <option value="@ReportSortOption.Name">Name (A–Z)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="filter">Show</label>
                        <select id="filter" class="form-select" @bind="filter">
                            <option value="@ReportFilter.All">All pages</option>
                            <option value="@ReportFilter.Rainy">Rainy birthdays</option>
                            <option value="@ReportFilter.Dry">Dry birthdays</option>
                            <option value="@ReportFilter.WithSpacePicture">With a NASA picture</option>
                            <option value="@ReportFilter.BornBefore2000">Born before 2000</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    var visible = VisibleReports;

    @if (visible.Count == 0)
    {
        <p class="hand">No pages match your search.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-5 scrap-grid">
            @for (int i = 0; i < visible.Count; i++)
            {
                var report = visible[i];
                <div class="col">
                   <div class="paper h-100 d-flex flex-column">
                     

                        @if (!string.IsNullOrEmpty(report.SpaceImageUrl))
                    {
                        <img class="saved-photo mb-3" src="@report.SpaceImageUrl" alt="@report.SpaceTitle" />
                    }
                    else
                    {
                        <div class="photo-placeholder mb-3">
                            <i class="bi bi-stars fs-3"></i>
                            <span class="small">No NASA picture for this day</span>
                        </div>
                    }

                        <h3 class="mb-0">@report.Name</h3>
                        <p class="small text-muted-sb mb-2">
                            @report.BirthDate.ToString("dddd, d MMMM yyyy") · @report.City
                        </p>

                        <p class="mb-2">
                            <i class="bi @WeatherCodeMapper.GetIconClass(report.WeatherCode) me-1"></i>
                               @WeatherCodeMapper.GetDescription(report.WeatherCode),
                               @(report.MaxTemperature.HasValue ? $"{report.MaxTemperature}°C" : "no temperature data")
                        </p>

                        @if (!string.IsNullOrEmpty(report.SpaceTitle))
                        {
                               @report.SpaceTitle
                        }

                        @if (!string.IsNullOrEmpty(report.HighlightEvent))
                        {
                            <p class="small mb-3 clamp-3"><i class="bi bi-book me-1"></i> @report.HighlightEvent</p>
                        }

                        <div class="mt-auto d-flex justify-content-between align-items-center gap-2">
                            <span class="small text-muted-sb">Saved @report.SavedAt.ToString("d MMM yyyy")</span>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteReport(report.Id)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<SavedReport> allReports = new();
    private SavedReport? warmest;
    private SavedReport? coldest;

    private string searchText = string.Empty;
    private ReportSortOption sortOption = ReportSortOption.RecentlySaved;
    private ReportFilter filter = ReportFilter.All;

    private bool isLoading = true;
    private string? errorMessage;

    // search, then filter, then sort - recalculated whenever the page re-renders
    private List<SavedReport> VisibleReports =>
        ReportQuery.Sort(
            ReportQuery.Filter(
                ReportQuery.Search(allReports, searchText),
                filter),
            sortOption);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allReports = await ReportStorage.GetAllAsync();
            UpdateSummary();
        }
        catch (IOException ex)
        {
            Logger.LogError(ex, "Couldn't read the saved reports file");
            errorMessage = "Couldn't load your saved pages.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteReport(Guid id)
    {
        try
        {
            await ReportStorage.DeleteAsync(id);
            allReports.RemoveAll(r => r.Id == id);
            UpdateSummary();
        }
        catch (IOException ex)
        {
            Logger.LogError(ex, "Couldn't delete report {Id}", id);
            errorMessage = "Couldn't delete that page. Please try again.";
        }
    }

    private void UpdateSummary()
    {
        warmest = ReportQuery.Warmest(allReports);
        coldest = ReportQuery.Coldest(allReports);
    }
}