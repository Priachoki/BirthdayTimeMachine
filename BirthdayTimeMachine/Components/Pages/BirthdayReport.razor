@page "/birthday"
@using BirthdayTimeMachine.Models
@using BirthdayTimeMachine.Services.Interfaces
@using BirthdayTimeMachine.Helpers
@using BirthdayTimeMachine.Services
@inject IGeocodingService GeocodingService
@inject IWeatherHistoryService WeatherService
@inject IOnThisDayService OnThisDayService
@inject INasaApodService NasaService
@inject IReportStorageService ReportStorage
@inject IMovieService MovieDb
@inject IHolidayService Holidays
@inject ILogger<BirthdayReport> Logger

<PageTitle>My birthday page</PageTitle>

<section class="mb-5">
    <h1 class="mb-1">My birthday page</h1>
    <p class="lead text-muted-sb mb-4">Tell us when and where you were born, and we'll travel back to that day.</p>


    <div class="cut-shadow">
        <div class="paper tape tilt-l px-4 pt-4 pb-3">
            <div class="row g-4 align-items-end">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label" for="name">Your name (optional)</label>
                    <input id="name" class="form-control" @bind="nameInput" placeholder="e.g. Priya" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <label class="form-label" for="city">Where were you born?</label>
                    <input id="city" class="form-control" @bind="cityInput" placeholder="e.g. Dublin" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <label class="form-label" for="dob">When?</label>
                    <input id="dob" type="date" class="form-control" @bind="birthDate" />
                </div>
                <div class="col-md-6 col-lg-3">
                    <button class="btn btn-primary btn-lg w-100" @onclick="ShowBirthday" disabled="@isLoading">
                        <i class="bi bi-clock-history"></i> Take me back
                    </button>
                </div>
            </div>
        </div>
    </div> 
</section>

@if (isLoading)
{
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="spinner-border" style="color: var(--sb-accent);" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <span class="hand fs-3">Travelling back in time...</span>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="paper note-pink mb-4">
        <i class="bi bi-exclamation-circle me-1"></i> @errorMessage
    </div>
}

@if (story != null && !isLoading)
{
    @* the story: all the APIs in one sentence *@
<div class="cut-shadow mb-5">
    <section class="paper lined tape tilt-r ps-4 ps-md-5 py-4 mb-5">
        <p class="hand accent fs-3 mb-1">
            The day @(string.IsNullOrWhiteSpace(nameInput) ? "I" : nameInput.Trim()) arrived · @birthDate.ToString("dddd, d MMMM yyyy")
        </p>
        <p class="story mb-3">
            @foreach (var part in story)
            {
                if (part.Kind == StoryPartKind.Plain)
                {
                    @part.Text
                }
                else
                {
                    <span class="@BirthdayStory.GetCssClass(part.Kind)">@part.Text</span>
                }
            }
        </p>

        @if (loadSeconds.HasValue)
        {
            <p class="small text-muted-sb mb-2">
                <i class="bi bi-lightning-charge"></i>
                Fetched from 5 web services in @loadSeconds.Value.ToString("0.0") seconds
            </p>
        }
        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var kind in story.Select(p => p.Kind).Where(k => k != StoryPartKind.Plain).Distinct())
            {
                <span class="source-tag @BirthdayStory.GetTagClass(kind)">@BirthdayStory.GetSourceName(kind)</span>
            }
        </div>

        @if (location != null)
        {
            <div class="d-flex flex-wrap align-items-center gap-3">
                <button class="btn btn-primary" @onclick="SaveReport" disabled="@isSaved">
                    <i class="bi bi-bookmark-heart"></i> @(isSaved ? "Saved!" : "Save this page")
                </button>
                @if (!string.IsNullOrEmpty(saveMessage))
                {
                    <span>@saveMessage</span>
                }
                @if (isSaved)
                {
                    <a href="saved">See my saved pages</a>
                }
            </div>
        }
    </section>
</div>

    @* hour by hour: one note per API *@
    <h2 class="mb-3">My birthday at a glance</h2>
    <div class="string-row mb-5">
        <div class="row g-4 pt-3 scrap-grid">
            <div class="col-md-6 col-lg-3">
                <div class="paper note-yellow tilt-l2 h-100">
                    <span class="pin"></span>
                    <p class="hand fs-3 mb-1">The weather</p>
                    @if (weather != null)
                    {
                        <p class="big-temp mb-1">@(weather.MaxTemperature)°C</p>
                        <p class="mb-1">
                            <i class="bi @WeatherCodeMapper.GetIconClass(weather.WeatherCode) me-1"></i>
                            @WeatherCodeMapper.GetDescription(weather.WeatherCode)
                        </p>
                        <p class="small mb-0">
                            Low @(weather.MinTemperature)°C · Rain @weather.Precipitation mm · Wind @weather.MaxWindSpeed km/h
                        </p>
                    }
                    else
                    {
                        <p class="mb-0 text-muted-sb">No weather found for this day.</p>
                    }
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="polaroid tilt-r h-100 mt-lg-3">
                    <span class="pin"></span>
                    @if (movies != null && movies.Count > 0)
                    {
                        var first = movies[0];
                        @if (!string.IsNullOrEmpty(first.PosterUrl))
                        {
                            <img src="@first.PosterUrl" alt="Poster for @first.Title" />
                        }
                        else
                        {
                            <div class="photo-placeholder"><i class="bi bi-film fs-3"></i></div>
                        }
                        <p class="hand fs-3 mb-0 mt-2">In the cinema</p>
                        <p class="small mb-0">@first.Title</p>
                    }
                    else
                    {
                        <div class="photo-placeholder"><i class="bi bi-film fs-3"></i></div>
                        <p class="hand fs-3 mb-0 mt-2">In the cinema</p>
                        <p class="small mb-0 text-muted-sb">@(movieMessage ?? "No films found.")</p>
                    }
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="polaroid tilt-l h-100 mt-lg-1">
                    <span class="pin"></span>
                    @if (spacePicture != null && !string.IsNullOrEmpty(spacePicture.ImageUrl))
                    {
                        <img src="@spacePicture.ImageUrl" alt="@spacePicture.Title" />
                    }
                    else if (spacePicture != null && spacePicture.IsVideo)
                    {
                        <a class="photo-placeholder text-decoration-none" href="@spacePicture.VideoUrl" target="_blank" rel="noopener">
                            <i class="bi bi-play-circle fs-2"></i> Watch NASA's video
                        </a>
                    }
                    else
                    {
                        <div class="photo-placeholder"><i class="bi bi-stars fs-3"></i></div>
                    }
                    <p class="hand fs-3 mb-0 mt-2">The night sky</p>
                    @if (spacePicture != null)
                    {
                        <p class="small mb-0">@spacePicture.Title</p>
                    }
                    else
                    {
                        <p class="small mb-0 text-muted-sb">@spaceMessage</p>
                        @if (showNasaLink)
                        {
                            <a class="small" href="@NasaApodService.GetOfficialPageUrl(birthDate)" target="_blank" rel="noopener">See it on NASA's website</a>
                        }
                    }
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="paper note-green tilt-r2 h-100 mt-lg-4">
                    <span class="pin"></span>
                    @if (holiday != null)
                    {
                        <p class="hand fs-3 mb-1">@HolidayHeading()</p>
                        <p class="fw-bold fs-5 mb-1">@holiday.Holiday.Name</p>
                        <p class="small mb-0">@holiday.Holiday.LocalName · public holiday in @location?.Country</p>
                    }
                    else
                    {
                        <p class="hand fs-3 mb-1">Holidays</p>
                        <p class="small mb-0 text-muted-sb">@(holidayMessage ?? "No holiday found.")</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* about me and where I was born *@
    <div class="row g-4 mb-5 scrap-grid">
        @if (age != null)
        {
            <div class="col-md-7">
                <div class="paper note-blue tilt-l h-100">
                    <span class="pin"></span>
                    <h3 class="mb-2"><i class="bi bi-person-heart"></i> Me, since then</h3>
                    <p class="mb-0">
                        Born on a <strong>@age.BornOnWeekday</strong>.
                        <strong>@age.Years</strong> years old, that's <strong>@age.TotalDays.ToString("N0")</strong> days
                        (@age.TotalWeeks.ToString("N0") weeks).
                        @if (age.IsBirthdayToday)
                        {
                            <span><i class="bi bi-balloon-heart"></i> Happy birthday, it's today!</span>
                        }
                        else
                        {
                            <span>
                                Next birthday is on a <strong>@age.NextBirthday.DayOfWeek</strong>
                                (@age.NextBirthday.ToString("d MMMM yyyy")), in <strong>@age.DaysUntilNextBirthday</strong> days.
                            </span>
                        }
                    </p>
                </div>
            </div>
        }

        @if (location != null)
        {
            <div class="col-md-5">
                <div class="paper tilt-r h-100">
                    <span class="pin"></span>
                    <h3 class="mb-2"><i class="bi bi-geo-alt"></i> Where I was born</h3>
                    <p class="mb-1"><span class="hl-city">@location.DisplayName</span></p>
                    <p class="small text-muted-sb mb-0">
                        @location.Latitude, @location.Longitude · @location.CountryCode
                    </p>
                </div>
            </div>
        }
    </div>

    @* NASA picture in full *@
    @if (spacePicture != null)
    {
        <h2 class="section-title">The sky that day</h2>
        <div class="row g-4 align-items-start mb-5">
            @if (!string.IsNullOrEmpty(spacePicture.ImageUrl))
            {
                <div class="col-lg-6">
                    <div class="polaroid tape tilt-l">
                        <img class="polaroid-large" src="@spacePicture.ImageUrl" alt="@spacePicture.Title" />
                        <p class="hand fs-3 mb-0 mt-2">@spacePicture.Title</p>
                    </div>
                </div>
            }
            <div class="col-lg-6">
                <div class="paper lined tilt-r ps-4">
                    <p class="hand fs-3 accent mb-1">@spacePicture.Title</p>
                    @if (spacePicture.IsVideo)
                    {
                        <p class="mb-2">
                            This day's picture is a video.
                            <a href="@spacePicture.VideoUrl" target="_blank" rel="noopener">Watch it here</a>
                        </p>
                    }
                    <p class="mb-2">@spacePicture.Explanation</p>
                    @if (!string.IsNullOrEmpty(spacePicture.Copyright))
                    {
                        <p class="small text-muted-sb mb-0">Image credit: @spacePicture.Copyright</p>
                    }
                </div>
            </div>
        </div>
    }

    @* films *@
    @if (movies != null && movies.Count > 0)
    {
        <h2 class="section-title">At the cinema that week</h2>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-4 scrap-grid">
            @for (int i = 0; i < movies.Count; i++)
            {
                var movie = movies[i];
                <div class="col">
                    <a href="@movie.TmdbUrl" target="_blank" rel="noopener" class="polaroid poster-polaroid">
                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                        {
                            <img src="@movie.PosterUrl" alt="Poster for @movie.Title" />
                        }
                        else
                        {
                            <div class="photo-placeholder">No poster</div>
                        }
                        <p class="fw-bold small mb-0 mt-2">@movie.Title</p>
                        <p class="small text-muted-sb mb-0">
                            <i class="bi bi-star-fill accent"></i> @movie.RatingText
                            · @movie.ReleaseDate?.ToString("d MMM")
                        </p>
                    </a>
                </div>
            }
        </div>
        <p class="small text-muted-sb mt-3">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
    }

    @* history *@
    @if (!string.IsNullOrEmpty(historyError))
    {
        <div class="paper note-pink mt-4"><i class="bi bi-exclamation-circle me-1"></i> @historyError</div>
    }

    @if (history != null)
    {
        <h2 class="section-title">Also on this day</h2>

        @if (history.SameYearEvents.Count > 0)
        {
            <div class="cut-shadow mb-5">
                <div class="paper note-green tilt-l">
                    <h3 class="mb-2">The year I was born (@birthDate.Year)</h3>
                    <ul class="mb-0">
                        @foreach (var e in history.SameYearEvents)
                        {
                            <li>@e.Text</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="row g-5">
            <div class="col-lg-6">
                <div class="paper tilt-r h-100 d-flex flex-column">
                    <h3 class="mb-2">In history</h3>
                    <EventList Items="history.Events.Take(2).ToList()" />
                    @if (history.Events.Count > 2)
                    {
                        <button class="btn btn-outline-secondary btn-sm align-self-start mt-3" @onclick="OpenEvents">
                            See all @history.Events.Count events
                        </button>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="paper tilt-l h-100 d-flex flex-column">
                    <h3 class="mb-2">Born on my birthday</h3>
                    <EventList Items="history.Births.Take(2).ToList()" />
                    @if (history.Births.Count > 2)
                    {
                        <button class="btn btn-outline-secondary btn-sm align-self-start mt-3" @onclick="OpenBirths">
                            See all @history.Births.Count people
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}

@* pop-up with the full list *@
@if (popupItems != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true"
         aria-labelledby="popup-title" @onclick="ClosePopup">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="popup-title">@popupTitle</h2>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="ClosePopup"></button>
                </div>
                <div class="modal-body">
                    <EventList Items="popupItems" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string cityInput = string.Empty;
    private DateOnly birthDate = new DateOnly(2000, 1, 1);
    private GeocodingResult? location;
    private WeatherDay? weather;
    private OnThisDayResult? history;
    private SpacePicture? spacePicture;
    private AgeSummary? age;
    private string? historyError;
    private string? errorMessage;
    private bool isLoading;
    private string? spaceMessage;
    private bool showNasaLink;
    private string nameInput = string.Empty;
    private bool isSaved;
    private string? saveMessage;
    private List<Movie>? movies;
    private string? movieMessage;
    private HolidayResult? holiday;
    private string? holidayMessage;
    private List<StoryPart>? story;
    private double? loadSeconds;

    // pop-up with the full history list
    private List<HistoryEvent>? popupItems;
    private string popupTitle = string.Empty;

    private void OpenEvents()
    {
        popupTitle = "On this day in history";
        popupItems = history?.Events.ToList();
    }

    private void OpenBirths()
    {
        popupTitle = "Born on my birthday";
        popupItems = history?.Births.ToList();
    }

    private void ClosePopup() => popupItems = null;

    // filled in when the home page sends a search, e.g. birthday?city=Dublin&date=2005-03-12
    [SupplyParameterFromQuery(Name = "name")]
    public string? NameFromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "city")]
    public string? CityFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "date")]
    public string? DateFromQuery { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // only run once, and only if the home page sent a city and a valid date
        if (!firstRender || string.IsNullOrWhiteSpace(CityFromQuery) ||
            !DateOnly.TryParseExact(DateFromQuery, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var date))
        {
            return;
        }

        cityInput = CityFromQuery;
        birthDate = date;
        nameInput = NameFromQuery ?? string.Empty;

        var search = ShowBirthday();
        StateHasChanged();   // shows the spinner while the APIs load
        await search;
        StateHasChanged();
    }

    private async Task ShowBirthday()
    {
        errorMessage = null;
        historyError = null;
        location = null;
        weather = null;
        history = null;
        spaceMessage = null;
        showNasaLink = false;
        spacePicture = null;
        age = null;
        isSaved = false;
        saveMessage = null;
        movies = null;
        movieMessage = null;
        holiday = null;
        holidayMessage = null;
        story = null;
        loadSeconds = null;

        // check the date before calling any APIs
        DateOnly today = DateOnly.FromDateTime(DateTime.Today);
        if (birthDate > today)
        {
            errorMessage = "Your date of birth can't be in the future.";
            return;
        }

        age = AgeCalculator.Calculate(birthDate, today);
        isLoading = true;
        var timer = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            // NASA, Wikipedia and TMDB only need the date, so start them straight away
            Task spaceTask = LoadSpacePicture();
            Task historyTask = LoadHistory();
            Task moviesTask = LoadMovies();

            // weather and holidays need the location first
            await LoadLocationAndWeather();
            Task holidayTask = LoadHoliday();

            // each Load method catches its own errors, so one failing doesn't stop the rest
            await Task.WhenAll(spaceTask, historyTask, moviesTask, holidayTask);

            BuildStory();
        }
        finally
        {
            timer.Stop();
            loadSeconds = timer.Elapsed.TotalSeconds;
            isLoading = false;
        }
    }

    // puts the results from every API into one sentence
    private void BuildStory()
    {
        var highlight = history?.SameYearEvents.FirstOrDefault() ?? history?.Events.FirstOrDefault();

        story = BirthdayStory.Build(new BirthdayStoryInput
        {
            Name = nameInput,
            BirthDate = birthDate,
            City = location?.Name,
            WeatherText = weather == null
                ? null
                : $"{WeatherCodeMapper.GetDescription(weather.WeatherCode).ToLower()}, {weather.MaxTemperature}°C",
            SpaceTitle = spacePicture?.Title,
            FilmTitle = movies?.FirstOrDefault()?.Title,
            HolidayName = holiday?.Holiday.Name,
            HolidayDaysFromBirthday = holiday == null || holiday.IsOnBirthday ? 0 : holiday.DaysFromBirthday,
            HistoryYear = highlight?.Year,
            HistoryText = highlight?.Text
        });
    }

    private string HolidayHeading()
    {
        if (holiday == null || holiday.IsOnBirthday)
        {
            return "On the day itself!";
        }

        string days = BirthdayStory.FormatDays(Math.Abs(holiday.DaysFromBirthday));
        return holiday.DaysFromBirthday > 0 ? $"{days} later" : $"{days} before";
    }

        private async Task LoadLocationAndWeather()
    {
        try
        {
            location = await GeocodingService.GetLocationAsync(cityInput);

            if (location == null)
            {
                errorMessage = $"We couldn't find \"{cityInput}\". Check the spelling and try again.";
                return;
            }

            weather = await WeatherService.GetWeatherForDateAsync(location.Latitude, location.Longitude, birthDate);

            if (weather == null)
            {
                errorMessage = "No weather data was found for that date.";
            }
        }
        catch (ArgumentOutOfRangeException ex)
        {
            Logger.LogInformation("Date out of range for weather: {Date}", birthDate);
            errorMessage = ex.Message.Split(" (Parameter")[0];
        }
        catch (ArgumentException ex)
        {
            Logger.LogInformation("Bad input for location: {City}", cityInput);
            errorMessage = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Geocoding or weather request failed for {City}", cityInput);
            errorMessage = "Couldn't reach the weather service. Check your internet connection.";
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Geocoding or weather request timed out for {City}", cityInput);
            errorMessage = "The service took too long to respond. Please try again.";
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Unexpected geocoding or weather response for {City}", cityInput);
            errorMessage = ex.Message;
        }
    }

    private async Task SaveReport()
    {
        if (location == null)
        {
            return;
        }

        var report = new SavedReport
        {
            Name = string.IsNullOrWhiteSpace(nameInput) ? "Me" : nameInput.Trim(),
            BirthDate = birthDate,
            City = location.DisplayName,
            CountryCode = location.CountryCode,
            MaxTemperature = weather?.MaxTemperature,
            MinTemperature = weather?.MinTemperature,
            Precipitation = weather?.Precipitation,
            MaxWindSpeed = weather?.MaxWindSpeed,
            WeatherCode = weather?.WeatherCode,
            SpaceTitle = spacePicture?.Title,
            SpaceImageUrl = spacePicture?.ImageUrl,
            HighlightEvent = history?.SameYearEvents.FirstOrDefault()?.Text
                             ?? history?.Events.FirstOrDefault()?.Text
        };

        try
        {
            await ReportStorage.SaveAsync(report);
            isSaved = true;
            saveMessage = "Page saved.";
        }
        catch (IOException ex)
        {
            Logger.LogError(ex, "Couldn't write the saved reports file");
            saveMessage = "Couldn't save the page. Please try again.";
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogError(ex, "No permission to write the saved reports file");
            saveMessage = "The app doesn't have permission to save pages.";
        }
    }

    private async Task LoadMovies()
    {
        try
        {
            movies = await MovieDb.GetMoviesAroundDateAsync(birthDate);

            if (movies.Count == 0)
            {
                movieMessage = "No well-known films were found around your birthday.";
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "TMDB request failed for {Date}", birthDate);
            movieMessage = "Couldn't reach the movie database right now.";
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "TMDB request timed out for {Date}", birthDate);
            movieMessage = "The movie database took too long to respond.";
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "TMDB problem (check the API key) for {Date}", birthDate);
            movieMessage = ex.Message;
        }
    }

    private async Task LoadHoliday()
    {
        // needs the country code from geocoding
        if (location == null)
        {
            return;
        }

        try
        {
            holiday = await Holidays.GetHolidayInfoAsync(birthDate, location.CountryCode);

            if (holiday == null)
            {
                holidayMessage = $"Public holiday data isn't available for {location.Country}.";
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Nager.Date request failed for {Country}", location.CountryCode);
            holidayMessage = "Couldn't reach the holiday service right now.";
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Nager.Date request timed out for {Country}", location.CountryCode);
            holidayMessage = "The holiday service took too long to respond.";
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Unexpected Nager.Date response for {Country}", location.CountryCode);
            holidayMessage = ex.Message;
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            history = await OnThisDayService.GetOnThisDayAsync(birthDate);

            if (history == null)
            {
                historyError = "No history was found for that day.";
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Wikipedia request failed for {Date}", birthDate);
            historyError = "Couldn't reach Wikipedia right now, so history isn't available.";
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Wikipedia request timed out for {Date}", birthDate);
            historyError = "Wikipedia took too long to respond.";
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Unexpected Wikipedia response for {Date}", birthDate);
            historyError = ex.Message;
        }
    }

    private async Task LoadSpacePicture()
    {
        // check the date first so we don't waste an API call
        if (!NasaApodService.IsDateAvailable(birthDate))
        {
            spaceMessage = $"NASA's Astronomy Picture of the Day started on {NasaApodService.FirstApodDate:d MMMM yyyy}, so there isn't one for this date.";
            return;
        }

        try
        {
            spacePicture = await NasaService.GetPictureAsync(birthDate);

            if (spacePicture == null)
            {
                Logger.LogInformation("NASA returned no usable picture for {Date}", birthDate);
                spaceMessage = "NASA's picture for this day isn't available through their API right now.";
                showNasaLink = true;
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "NASA request failed for {Date}", birthDate);
            spaceMessage = "Couldn't reach NASA right now.";
            showNasaLink = true;
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "NASA request timed out for {Date}", birthDate);
            spaceMessage = "NASA took too long to respond.";
            showNasaLink = true;
        }
        catch (InvalidOperationException ex)
        {
            Logger.LogWarning(ex, "Unexpected NASA response for {Date}", birthDate);
            spaceMessage = ex.Message;
        }
    }
}