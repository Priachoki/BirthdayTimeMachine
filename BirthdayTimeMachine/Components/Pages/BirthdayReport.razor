@page "/birthday"
@using BirthdayTimeMachine.Models
@using BirthdayTimeMachine.Services.Interfaces
@inject IGeocodingService GeocodingService

<PageTitle>Birthday Report</PageTitle>

<h1>Birthday Time Machine</h1>

<div class="mb-3" style="max-width: 400px;">
    <label class="form-label">City you were born in</label>
    <input class="form-control" @bind="cityInput" placeholder="e.g. Dublin" />
</div>

<button class="btn btn-primary" @onclick="FindCity" disabled="@isLoading">
    Find city
</button>

@if (isLoading)
{
    <div class="spinner-border text-primary mt-3" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger mt-3">@errorMessage</div>
}

@if (location != null)
{
    <div class="alert alert-success mt-3">
        <h5>@location.DisplayName</h5>
        <p class="mb-0">
            Latitude: @location.Latitude, Longitude: @location.Longitude<br />
            Country code: @location.CountryCode
        </p>
    </div>
}

@code {
    private string cityInput = string.Empty;
    private GeocodingResult? location;
    private string? errorMessage;
    private bool isLoading;

    private async Task FindCity()
    {
        errorMessage = null;
        location = null;
        isLoading = true;

        try
        {
            location = await GeocodingService.GetLocationAsync(cityInput);

            if (location == null)
            {
                errorMessage = $"We couldn't find \"{cityInput}\". Check the spelling and try again.";
            }
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Couldn't reach the location service. Check your internet connection.";
        }
        catch (TaskCanceledException)
        {
            errorMessage = "The location service took too long. Please try again.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}